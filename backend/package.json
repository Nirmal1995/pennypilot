{
  "name": "pennypilot-api",
  "version": "1.0.0",
  "description": "PennyPilot REST API: expense and income tracking backed by PostgreSQL",
  "main": "src/server.js",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/migrate.js",
    "lint": "eslint .",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\"",
    "test:ci": "mkdir -p reports && node --test --test-concurrency=1 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=reports/junit.xml \"test/**/*.test.js\""
  },
  "dependencies": {
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "supertest": "^7.0.0"
  }
}
